# .env.example — REFERENSI DOKUMENTASI SAJA.
# File yang dibaca runtime: web/.env.local (dan web/.env.production di VPS)
# Salin file ini ke web/.env.local lalu isi nilainya.

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgres://mapur:<password>@127.0.0.1:5432/mapur

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://<domain>

# ── Auth admin (JWT) — string acak min 32 karakter ───────────
SESSION_SECRET=<string-acak-panjang>

# ── Cloudflare R2 (kosongkan untuk pakai disk lokal saat dev) ─
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mapur-media
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Turnstile anti-spam ───────────────────────────────────────
# Test keys (lokal): site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── IP hashing ────────────────────────────────────────────────
IP_HASH_SALT=<string-acak>
